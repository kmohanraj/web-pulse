{
  "name": "webpulse-qa",
  "version": "1.0.0",
  "private": true,
  "description": "WebPulse QA browser extension shell (Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "chart.js": "^4.4.7",
    "jspdf": "^2.5.2",
    "xlsx": "^0.18.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "vite": "^6.0.7"
  }
}
